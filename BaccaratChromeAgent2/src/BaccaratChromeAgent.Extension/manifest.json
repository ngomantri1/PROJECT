{
  "manifest_version": 3,
  "key": "",
  "name": "Baccarat Chrome Agent",
  "version": "0.1.10",
  "description": "Bridge read-only giữa Chrome và BaccaratChromeAgent Engine.",
  "permissions": ["nativeMessaging", "storage", "debugger", "webNavigation"],
  "host_permissions": ["https://*/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["debugger-bootstrap.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://*/*"],
      "js": ["webview-compat.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://*/*"],
      "js": ["legacy-v4_js_xoc_dia_live.js", "legacy-push-start.js"],
      "world": "MAIN",
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://*/*"],
      "js": ["content-bridge.js", "canvas-overlay.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
