# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TIME_ZONE=Asia/Bangkok

# PostgreSQL
POSTGRES_DB=coin_spot
POSTGRES_USER=coin_spot
POSTGRES_PASSWORD=coin_spot_dev_password
DB_HOST=postgres
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# External data
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
DEFILLAMA_BASE_URL=https://api.llama.fi
RESEARCH_DEFILLAMA_ENABLED=true
BINANCE_BASE_URL=https://api.binance.com
BINANCE_MARKET_DATA_BASE_URLS=https://data-api.binance.vision,https://api.binance.com,https://api-gcp.binance.com
COINPAPRIKA_BASE_URL=https://api.coinpaprika.com/v1
CMC_BASE_URL=https://pro-api.coinmarketcap.com
CMC_API_KEY=
CMC_HISTORICAL_ENABLED=true
UNLOCK_WEB_CRAWL_ENABLED=false
HTTP_TIMEOUT_SECONDS=25
USER_AGENT=CoinSpotScannerV8.1-Educational/0.1

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
