<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>BaccaratChromeAgent.Desktop</AssemblyName>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BaccaratChromeAgent.Protocol\BaccaratChromeAgent.Protocol.csproj" />
  </ItemGroup>

  <!--
    Chỉ giữ SDK WebView2 tạm thời để biên dịch nguyên code-behind cũ trong
    giai đoạn 1. Desktop mới không đóng gói Fixed Runtime, ZIP hay JavaScript cũ.
    Toàn bộ khởi tạo/điều hướng WebView bị chặn trong Window_Loaded.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3485.44" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*.png" />
    <Resource Include="Assets\**\*.jpg" />
    <Resource Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>
</Project>
