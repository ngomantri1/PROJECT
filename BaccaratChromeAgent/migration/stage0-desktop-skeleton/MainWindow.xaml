<Window x:Class="BaccaratChromeAgent.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Baccarat Chrome Agent" Height="800" Width="1180" MinHeight="650" MinWidth="980"
        Background="#F4F6F8">
  <Grid Margin="16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <Border Grid.ColumnSpan="2" Background="#172033" CornerRadius="8" Padding="16" Margin="0,0,0,14">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left"><TextBlock Text="Baccarat Chrome Agent" Foreground="White" FontSize="22" FontWeight="Bold"/>
          <TextBlock Text="Chrome Desktop Controller" Foreground="#B9C6DD" Margin="0,4,0,0"/></StackPanel>
        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right"><TextBlock Text="{Binding ConnectionText}" Foreground="{Binding ConnectionBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
          <TextBlock Text="{Binding StatusText}" Foreground="#D7E0F0" Margin="0,4,0,0"/></StackPanel>
      </DockPanel>
    </Border>

    <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,14,0">
      <StackPanel>
        <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Chiến lược &amp; Chuỗi tiền" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Text="CHIẾN LƯỢC" VerticalAlignment="Center" Foreground="#1264C6" FontWeight="SemiBold"/>
              <ComboBox Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="1) Chuỗi cầu B/P (Banker/Player tự nhập)"/><ComboBoxItem Content="2) Thế cầu B/P"/><ComboBoxItem Content="5) Bám cầu trước (thông minh)"/></ComboBox>
              <TextBlock Grid.Row="1" Text="CHUỖI CẦU" VerticalAlignment="Center" Foreground="#1264C6" FontWeight="SemiBold"/>
              <TextBox Grid.Row="1" Grid.Column="1" Text="BBBBPPPP"/>
              <TextBlock Grid.Row="2" Text="QUẢN LÝ VỐN" VerticalAlignment="Center" Foreground="#1264C6" FontWeight="SemiBold"/>
              <ComboBox Grid.Row="2" Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="Tăng mức tiền khi thua, thắng quay về mức đầu"/><ComboBoxItem Content="Thua thắng đều lên mức"/></ComboBox>
              <TextBlock Grid.Row="3" Text="CHUỖI TIỀN" VerticalAlignment="Center" Foreground="#1264C6" FontWeight="SemiBold"/>
              <TextBox Grid.Row="3" Grid.Column="1" Text="10-0-10-0-10-0-10-0"/>
              <TextBlock Grid.Row="4" Text="ĐẶT KHI CÒN (GIÂY)" VerticalAlignment="Center" Foreground="#1264C6" FontWeight="SemiBold"/>
              <TextBox Grid.Row="4" Grid.Column="1" Text="10"/>
            </Grid>
            <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="CẮT LÃI" Foreground="#1264C6" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="0"/>
              <TextBlock Grid.Column="2" Text="CẮT LỖ" Foreground="#1264C6" FontWeight="SemiBold" Margin="16,0,8,0" VerticalAlignment="Center"/><TextBox Grid.Column="3" Text="0"/>
            </Grid>
            <CheckBox Content="Tiền thắng >= 0 tự động quay về mức cược đầu" HorizontalAlignment="Center" Margin="0,8"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
              <Button Content="Kiểm tra bridge đặt cược" Click="CheckBridge_Click" Background="#1976D2" Foreground="White"/>
              <Button Content="Dừng" Click="Stop_Click" Background="#E53935" Foreground="White"/>
              <CheckBox Content="Khóa chuột" VerticalAlignment="Center" Margin="12,0"/>
            </StackPanel>
            <TextBlock Text="Chế độ an toàn: chưa gửi lệnh đặt cược. Chỉ kiểm tra kết nối và bridge." Foreground="#C62828" HorizontalAlignment="Center" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
        <Border Background="White" CornerRadius="8" Padding="16">
          <StackPanel><TextBlock Text="Nhật ký" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" Height="150" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Grid.Column="1">
      <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12"><StackPanel>
        <TextBlock Text="Trạng thái" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <TextBlock Text="BÀN" Foreground="#1264C6"/><TextBlock Text="{Binding TableText}" FontSize="22" FontWeight="Bold" Margin="0,2,0,10"/>
        <TextBlock Text="VÒNG" Foreground="#1264C6"/><TextBlock Text="{Binding RoundText}" FontSize="20" FontWeight="Bold" Margin="0,2,0,10"/>
        <TextBlock Text="CHUỖI KẾT QUẢ" Foreground="#1264C6"/><TextBlock Text="{Binding SequenceText}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap"/>
      </StackPanel></Border>
      <Border Background="White" CornerRadius="8" Padding="16"><StackPanel>
        <TextBlock Text="Triển khai" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Text="1. Extension cài từ Chrome Web Store (Unlisted)." TextWrapping="Wrap" Margin="0,3"/>
        <TextBlock Text="2. Desktop installer đăng ký Native Host tự động." TextWrapping="Wrap" Margin="0,3"/>
        <TextBlock Text="3. Extension ID được khóa trong Native Host manifest." TextWrapping="Wrap" Margin="0,3"/>
      </StackPanel></Border>
    </StackPanel>
  </Grid>
</Window>
